# Copy to .env and fill in. .env is gitignored; never commit a real value.

# Postgres (Docker, local only)
POSTGRES_PORT=5432
POSTGRES_DB=shop
POSTGRES_PASSWORD=change-me-admin
# least-privilege role the MCP Toolbox connects as
TOOLBOX_DB_USER=toolbox
TOOLBOX_DB_PASSWORD=change-me-toolbox

# MCP Toolbox port (5000 is taken by macOS AirPlay Receiver)
TOOLBOX_PORT=5001

# needed from stage 3 on
GOOGLE_API_KEY=
# needed from stage 8 on
MEM0_API_KEY=

# A2A guard services
JUDGE_PORT=10002
MASKER_PORT=10003

# Models (stage 6+): claude-* runs on the Claude API, anything else on Gemini.
# Gemini free tier was 20 req/day for Gemini 3 Flash; see DESIGN.md.
AGENT_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-haiku-4-5
# Claude API key (console.anthropic.com); never commit it
ANTHROPIC_API_KEY=
